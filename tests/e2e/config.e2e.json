// Server configuration for Playwright runs (see tests/e2e/start-server.ts).
{
  "backend": "file",
  "file": { "path": "./.tmp/data" },
  "server": {
    "port": 8181,
    "allowedOrigins": [],
    "allowFileClient": true,
    "clientDir": "../../client/dist"
  },
  "mcp": { "enabled": true, "path": "/mcp" },
  "auth": {
    "mode": "local",
    "local": { "passwordMinLength": 8, "sessionTimeoutMinutes": 60 }
  }
}
