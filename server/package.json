{
  "name": "@planning/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file=.env.development src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --conditions=source --env-file-if-exists=.env.development scripts/migrate.ts",
    "migrate:make": "tsx scripts/make-migration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@planning/shared": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "ldapts": "^9.2.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "tarn": "^3.0.2",
    "tedious": "^20.3.8",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mssqlserver": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  }
}
